{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "CableScope",
  "version": "1.0.0",
  "identifier": "com.endymi0n74.cablescope",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1480",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "CableScope — USB-C Inspector",
        "width": 900,
        "height": 680,
        "minWidth": 720,
        "minHeight": 520,
        "center": true,
        "decorations": true,
        "transparent": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
